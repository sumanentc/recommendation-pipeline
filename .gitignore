# --- Python / environments
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- macOS
.DS_Store

# --- Pipeline data (re-created by the pipeline; keep only the folder structure)
data/raw/ml-100k.zip
data/raw/*
# keep sample CSVs (5-row previews of derived datasets for visibility in git)
!data/samples/
data/processed/*
data/features/*
!data/*/.gitkeep
# ...but DO keep the error dataset as evidence of the validation stage
!data/errors/
data/errors/*
!data/errors/.gitkeep
!data/errors/rejected_*.csv
!data/errors/validation_issues.csv

# --- Models + experiment tracking (local, large, re-created by the pipeline)
models/*.joblib
mlruns/
mlartifacts/
mlflow.db
.prefect/

# --- Intermediate report rendering (the PDF is the deliverable)
reports/*.html
reports/final_report_draft.md

# --- Logs
logs/*
!logs/.gitkeep

# --- Editors
.idea/
.vscode/
